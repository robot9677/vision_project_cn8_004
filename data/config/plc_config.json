{
  "enabled": true,
  "backend": "modbus_rtu_slave",
  "serial": {
    "port": "/dev/ttyUSB1",
    "baudrate": 9600,
    "bytesize": 8,
    "parity": "N",
    "stopbits": 1,
    "timeout": 1,
    "reconnect_interval_sec": 1.0,
    "require_reset_after_runtime_disconnect": true,
    "require_initial_rx": true,
    "rx_watchdog_sec": 5.0,
    "rx_watchdog_startup_grace_sec": 20.0
  },
  "modbus": {
    "slave_id": 1
  },
  "registers": {
    "command": 200,
    "status": 201,
    "result": 202,
    "heartbeat": 203,
    "vision_ready": 204
  },
  "vision_ready": {
    "ready_value": 100,
    "not_ready_value": 0
  },
  "heartbeat": {
    "interval_sec": 0.5,
    "max_value": 9999
  },
  "shutdown": {
    "command": "sudo /sbin/shutdown -h now",
    "ready_hold_sec": 2.0
  },
  "recovery": {
    "camera_open_timeout_sec": 2.0,
    "camera_retry_interval_sec": 0.1,
    "camera_grace_sec": 2.0,
    "frame_timeout_sec": 1.0
  },
  "live_trace": {
    "enabled": true,
    "path": "data/logs/plc_live.jsonl",
    "max_bytes": 5242880,
    "keep_files": 2,
    "include_state_changes": true,
    "include_heartbeat": false
  },
  "error_test": {
    "enabled": true,
    "request_path": "data/runtime/plc_error_test_request.json",
    "delete_after_read": true,
    "allowed_types": [
      "camera",
      "light",
      "inspection",
      "plc_comm"
    ],
    "allow_hardware_fault_tests": false,
    "allowed_modes": [
      "logic",
      "recovery"
    ],
    "camera_health_frames": 3,
    "camera_health_timeout_sec": 1.5
  },
  "service_panel": {
    "enabled": true,
    "panel_width": 600,
    "opacity": 0.96,
    "password_sha256": "2e29ae4c214d913412f389feea5bcacf1fca48c8a4669dbd5c7d8c2a989d728f",
    "lock_on_close": true,
    "show_roi_debug": true,
    "rx_tx_rows": 3,
    "refresh_hz": 5.0,
    "roi_debug_hz": 1.0,
    "soak_test": {
      "enabled": true,
      "interval_sec": 10.0,
      "reset_delay_sec": 2.0,
      "start_delay_sec": 1.0,
      "log_dir": "soak_tests",
      "keep_days": 14,
      "keep_sessions": 20,
      "tracking_stable_frames": 3,
      "tracking_wait_log_sec": 5.0,
      "fresh_frame_count": 4
    }
  },
  "diagnostics": {
    "enabled": true,
    "index_path": "diagnostics/diagnostics_index.jsonl",
    "index_max_bytes": 2097152,
    "index_keep_files": 2,
    "keep_days": 14,
    "error_keep_files": 60,
    "test_keep_files": 120,
    "normal_keep_files": 5,
    "normal_sample_every": 20,
    "prune_interval_sec": 30.0
  }
}
