certutil -f -decode "%TEMP_B64%" "%TEMP_SH%" >nul 2>&1
if errorlevel 1 (
    echo [ERROR] Failed to create temporary shell script.
    del /q "%TEMP_B64%" 2>nul
    exit /b 1
)

echo [2/6] Check SSH connection
ssh -o BatchMode=yes -o ConnectTimeout=10 -i "%SSH_KEY%" %TARGET% "echo SSH_OK"
if errorlevel 1 (
    echo [ERROR] SSH connection failed. No process was stopped.
    del /q "%TEMP_B64%" "%TEMP_SH%" 2>nul
    exit /b 1
)

echo [3/6] Upload collector script
scp -q -o BatchMode=yes -i "%SSH_KEY%" "%TEMP_SH%" "%TARGET%:%REMOTE_SCRIPT%"
if errorlevel 1 (
    echo [ERROR] Upload failed. No process was stopped.
    del /q "%TEMP_B64%" "%TEMP_SH%" 2>nul
    exit /b 1
)

echo [4/6] Collect logs first, then stop vision/test processes
ssh -tt -o BatchMode=yes -i "%SSH_KEY%" %TARGET% "chmod 700 %REMOTE_SCRIPT% && bash %REMOTE_SCRIPT%; rc=$?; rm -f %REMOTE_SCRIPT%; exit $rc" > "%RESULT_FILE%" 2>&1
set "SSH_RC=%ERRORLEVEL%"
type "%RESULT_FILE%"
if not "%SSH_RC%"=="0" (
    echo [ERROR] Remote collection command failed: rc=%SSH_RC%
    echo [INFO] Result file: %RESULT_FILE%
    del /q "%TEMP_B64%" "%TEMP_SH%" 2>nul
    exit /b %SSH_RC%
)

set "REMOTE_ARCHIVE="
for /f "tokens=1,* delims==" %%A in ('findstr /b /c:"ARCHIVE=" "%RESULT_FILE%"') do set "REMOTE_ARCHIVE=%%B"
if not defined REMOTE_ARCHIVE (
    echo [ERROR] Remote archive path was not returned.
    echo [INFO] Result file: %RESULT_FILE%
    del /q "%TEMP_B64%" "%TEMP_SH%" 2>nul
    exit /b 1
)

for %%F in ("%REMOTE_ARCHIVE%") do set "ARCHIVE_NAME=%%~nxF"
set "LOCAL_ARCHIVE=%LOCAL_BUNDLE_ROOT%\%ARCHIVE_NAME%"

echo [5/6] Download diagnostic archive
scp -q -o BatchMode=yes -i "%SSH_KEY%" "%TARGET%:%REMOTE_ARCHIVE%" "%LOCAL_ARCHIVE%"
if errorlevel 1 (
    echo [ERROR] Download failed. Remote archive remains at:
    echo %REMOTE_ARCHIVE%
    del /q "%TEMP_B64%" "%TEMP_SH%" 2>nul
    exit /b 1
)

echo [6/6] Extract archive to one folder
tar -xzf "%LOCAL_ARCHIVE%" -C "%LOCAL_BUNDLE_ROOT%"
if errorlevel 1 (
    echo [WARN] Archive downloaded but automatic extraction failed.
    echo [ARCHIVE] %LOCAL_ARCHIVE%
) else (
    echo [OK] Archive : %LOCAL_ARCHIVE%
    echo [OK] Folder  : %LOCAL_BUNDLE_ROOT%
)

del /q "%TEMP_B64%" "%TEMP_SH%" "%RESULT_FILE%" 2>nul

echo.
echo ============================================
echo LOG COLLECTION AND PROCESS STOP COMPLETE
echo Manual start on Jetson:
echo cd ~/vision_project/src
echo python3 main_vp.py --startup-mode run
echo ============================================
pause
exit /b 0
